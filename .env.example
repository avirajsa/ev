# EV Backend Configuration Template

# Server Settings
APP_NAME=EV-Backend
APP_ENV=development
SECRET_KEY=ev_super_secret_jwt_key_change_me_in_production
HOST=0.0.0.0
PORT=8000

# OpenRouter & LLM Configuration
OPENROUTER_API_KEY=your_openrouter_api_key_here
PRIMARY_MODEL=anthropic/claude-3.5-sonnet
FALLBACK_MODELS=["openai/gpt-4o","google/gemini-2.0-flash-001","meta-llama/llama-3.3-70b-instruct"]

# Database & Cache
DATABASE_URL=postgresql+asyncpg://ev_user:ev_password@localhost:5432/ev_db
REDIS_URL=redis://localhost:6379/0

# Security & Devices
DEVICE_AUTH_SECRET=ev_device_shared_secret_token_12345
ALLOWED_CLIENT_ORIGINS=["*"]

# Audio / Voice Pipelines (Optional external STT/TTS)
ELEVENLABS_API_KEY=
DEEPGRAM_API_KEY=
